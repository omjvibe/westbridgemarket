# ==========================================================
# WESTBRIDGE MARKET - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values
# ==========================================================

# 1. SUPABASE CONFIGURATION
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. EMAIL CONFIGURATION (RESEND)
# Found in Resend Dashboard > API Keys
RESEND_API_KEY=re_your_api_key

# 3. APP CONFIGURATION
# Use http://localhost:3000 for local development
# Use your production URL (e.g., https://westbridgemarket.app) for production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. ADMIN CONFIGURATION
# The PIN code required for sensitive admin operations
ADMIN_PIN_CODE=123456

# 5. HCAPTCHA CONFIGURATION
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# 6. SUPABASE AUTH REDIRECT (Optional)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/dashboard
